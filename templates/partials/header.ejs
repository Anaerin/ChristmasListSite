<!DOCTYPE html>
<html>
<head>
	<meta charset='utf-8'>
	<meta http-equiv='X-UA-Compatible' content='IE=edge'>
	<title><%=title%></title>
	<meta name='viewport' content='width=device-width, initial-scale=1'>
	<link rel='stylesheet' type='text/css' media='screen' href='stylesheet.css'>
</head>
<body>
<header>
	<div class="navigation"><a href="/">Home</a></div>
	<div class="personalization">
	<% if (locals.userEntry) { %>
		<div class="logoutBar">Welcome, <a href="/myaccount"><%=userEntry.name%></a>! (Not you? <a href="/logout">Logout</a>)</div>
	<% } else { %>
		<div class="loginBar">Welcome, guest. Please <a href="/login">Log in</a><% if (registrationEnabled) { %> or <a href="/register">Register</a><% } %></div>
	<% } %>
	</div>
</header>